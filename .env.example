# Semantic stroke generation and agent chat via OpenRouter.
# Copy to .env.local; never commit credentials.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000

# Production on Render requires PostgreSQL. Use a dedicated Noema database
# and restricted app role, even when sharing an existing PostgreSQL instance.
# Prefer Render's internal connection URL when service and DB share a region.
DATABASE_URL=

# Local development uses durable SQLite when DATABASE_URL is empty.
# Explicitly set this when running a local production build (next start).
# Never use SQLite on Render's ephemeral filesystem.
NOEMA_SQLITE_PATH=.noema/noema.sqlite

# Optional, one-time admin input for scripts/provision-noema-database.cjs.
# Do not set this admin credential on the deployed web service.
NOEMA_ADMIN_DATABASE_URL=
