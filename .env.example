# Semantic stroke generation + agent chat via OpenRouter.
# Copy to `.env.local` and fill in. With a key, A→B strokes use the agent's real
# model for the semantic transform and the chat panel talks to the real model.
# Without a key the system still runs — stroke generation falls back to a
# deterministic synthetic path and chat to an on-theme canned reply.

# Your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Sent as the HTTP-Referer attribution header (your deployed domain).
OPENROUTER_SITE_URL=https://agent-stroke.local



